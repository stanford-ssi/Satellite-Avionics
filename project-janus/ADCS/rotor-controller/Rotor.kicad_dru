(version 1)

(rule "Tag-Connect contact keepout clearance"
    (layer "B.Cu")
    (condition "A.Type == 'Pad' && A.memberOfFootprint('J1') && (B.Type == 'Track' || B.Type == 'Via' || B.Type == 'Zone')")
    (constraint clearance (min 0.508mm)))

(rule "Tag-Connect contact field"
    (layer "B.Cu")
    (condition "A.intersectsArea('Tag-Connect contact keepout')")
    (constraint disallow track via))

(rule "Keep L2 and L5 clear for ground returns"
    (condition "A.Type == 'Track' && (A.Layer == 'In1.Cu' || A.Layer == 'In4.Cu')")
    (constraint disallow track))

(rule "Reserve L4 for power distribution"
    (layer "In3.Cu")
    (condition "A.Type == 'Track' && A.NetName != '+3V3' && A.NetName != '/MOTOR_VM' && A.NetName != '/Motor control/VCORE'")
    (constraint disallow track))

(rule "Set component-side ground pour back from CAN traces"
    (layer "F.Cu")
    (condition "A.Type == 'Zone' && A.NetName == 'GND' && B.Type == 'Track' && (B.NetName == '/CAN and housekeeping/CAN_H' || B.NetName == '/CAN and housekeeping/CAN_L')")
    (constraint clearance (min 0.40mm)))

(rule "Keep ordinary routing at 0.13 mm minimum"
    (condition "A.Type == 'Track' && A.NetName != '/CAN and housekeeping/CAN_H' && A.NetName != '/CAN and housekeeping/CAN_L'")
    (constraint track_width (min 0.13mm)))

(rule "CAN differential geometry on L1"
    (layer "F.Cu")
    (condition "A.NetName == '/CAN and housekeeping/CAN_H' || A.NetName == '/CAN and housekeeping/CAN_L'")
    (constraint track_width (min 0.115mm) (opt 0.115mm) (max 0.115mm)))

(rule "Keep RP2350 switch node and filtered analog supply on top"
    (condition "(A.NetName == 'Net-(U1-VREG_AVDD)' || A.NetName == 'Net-(U1-VREG_LX)') && (A.Type == 'Via' || (A.Type == 'Track' && A.Layer != 'F.Cu'))")
    (constraint disallow track via))
