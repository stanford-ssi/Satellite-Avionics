(footprint "Vishay_WSL0603_1608Metric"
    (version 20241229)
    (generator pcbnew)
    (layer "F.Cu")
    (descr "Vishay WSL0603 Power Metal Strip two-terminal current shunt. Vishay document 30100, recommended a=b=0.040 in, inter-pad gap=0.020 in. Route Kelvin taps to inside edges of pads. https://www.vishay.com/docs/30100/wsl.pdf")
    (tags "Vishay WSL0603 shunt 100 milliohm")
    (attr smd)
    (property "Reference" "REF**" (at 0 -1.25) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "Vishay_WSL0603_1608Metric" (at 0 1.25) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (fp_rect (start -1.45 -0.68) (end 1.45 0.68) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
    (fp_rect (start -0.762 -0.381) (end 0.762 0.381) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
    (pad "1" smd roundrect (at -0.762 0) (size 1.016 1.016) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.05))
    (pad "2" smd roundrect (at 0.762 0) (size 1.016 1.016) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.05))
    (model "${KICAD10_3DMODEL_DIR}/Resistor_SMD.3dshapes/R_0603_1608Metric.step" (offset (xyz 0 0 0)) (scale (xyz 0.9525 0.9525 0.9031)) (rotate (xyz 0 0 0)))
)
