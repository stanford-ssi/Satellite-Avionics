	(text "CHARGE PATH B: CHG_IN (regulated CC/CV from the BCDR, 8.4 V max) -> Q4 -> F4 1.5 A -> BT3+ (BT_POS)"
		(exclude_from_sim no)
		(at 50.8 50.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2dc68860-dde9-4bbf-a6c1-2dda1911149b")
	)
	(text "U5 (LTC4412) turns Q4 fully on when CHG_IN is ~20 mV above the string, and off when the string is higher,\nso current only flows INTO the string and the two strings never feed each other.\nCTL tied to GND = always automatic. STAT unused (can go to an MCU later).\nQ4's body diode still conducts when it is off: the charge stop is the BCDR (charger disable).\nSame circuit as OreSat0's flown charge path (LTC4412 + Si7625DN + 1206L150)."
		(exclude_from_sim no)
		(at 50.8 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c512f043-5d51-4f0f-b3fb-62f1196b1c6b")
	)
