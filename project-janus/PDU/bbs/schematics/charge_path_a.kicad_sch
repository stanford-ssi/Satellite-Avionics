	(text "CHARGE PATH A: CHG_IN (regulated CC/CV from the BCDR, 8.4 V max) -> Q3 -> F3 1.5 A -> BT1+ (BT_POS)"
		(exclude_from_sim no)
		(at 50.8 50.8 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "02179151-fdcc-4cd7-8816-9cbff6fc9b63")
	)
	(text "U4 (LTC4412) turns Q3 fully on when CHG_IN is ~20 mV above the string, and off when the string is higher,\nso current only flows INTO the string and the two strings never feed each other.\nCTL tied to GND = always automatic. STAT unused (can go to an MCU later).\nQ3's body diode still conducts when it is off: the charge stop is the BCDR (charger disable).\nSame circuit as OreSat0's flown charge path (LTC4412 + Si7625DN + 1206L150)."
		(exclude_from_sim no)
		(at 50.8 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "608247e0-6112-43c4-81fc-327849179b0e")
	)
