	(text "Internal R_pd range is 36 to 113 kohms at 3v3\n10kohm pull-up resistor yields\n3.3V*(R_pd/(10kohm+R_pd)\nvoltage range is 2.583V to 3.032V,\nmore than 0.7*VDD=2.31V required,\nbut kinda close"
		(exclude_from_sim no)
		(at 16.256 173.736 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
