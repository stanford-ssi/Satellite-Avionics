	)
	(text "OUTPUT VOLTAGE SENSING - applies to all channels\n\nVadc = Vout * (3.3k / (10k + 3.3k)) \nat Vout = 8.4V: Vadc = 2.084V\n\nRth = 3.3k * 10k / (3.3k + 10k) = 2.48k\nFilter cutoff = 1 / (2pi * 2.48K * 1uF) = 64.2Hz\nTime Const = 2.48k * 1uF = 2.48ms\n1%_settle = -2.48ms * ln(.01) = 2.48ms * 4.605 = 11.4ms\n\nIadc = (8.4V - 2.084V) / 10k = .632mA"
		(exclude_from_sim no)
		(at 236.982 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3d7f1f47-85c8-43ec-a2e6-cc06c7a30e6e")
	)
